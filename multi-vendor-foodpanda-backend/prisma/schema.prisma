generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// IDENTITY & USERS
// -----------------------------------------------------------------------------
model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  profileImage String?

  // A single user can have multiple roles across different restaurants (tenants).
  userRoles UserRole[]

  // Links to specific profiles
  customer Customer?
  rider    Rider?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// MULTI-TENANCY (RESTAURANTS)
// -----------------------------------------------------------------------------
model Tenant {
  id                 String  @id @default(uuid())
  name               String
  description        String?
  logo               String?
  coverImage         String?
  cuisine            String[] @default([])
  rating             Float    @default(4.5)
  deliveryTime       String   @default("30-45 min")
  deliveryRadiusKm   Float    @default(5.0)
  commissionRate     Float    @default(10.0) // Platform commission %
  lat                Float?
  lng                Float?
  isActive           Boolean  @default(true)
  verificationStatus String   @default("APPROVED") // PENDING, UNDER_REVIEW, APPROVED, REJECTED

  // Stripe Integration
  stripeAccountId          String?
  stripeOnboardingComplete Boolean  @default(false)

  // Multi-tenant isolation relationships
  branches  Branch[]
  roles     Role[] // Tenant-specific custom roles (optional)
  userRoles UserRole[]

  // Menu relations
  menuCategories MenuCategory[]
  menuItems      MenuItem[]

  orders         Order[]
  coupons        Coupon[]
  reviews        Review[]

  // Inventory
  ingredients    Ingredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// ROLE-BASED ACCESS CONTROL (RBAC)
// -----------------------------------------------------------------------------
model Role {
  id          String  @id @default(uuid())
  name        String // e.g., "SUPER_ADMIN", "RESTAURANT_OWNER", "KITCHEN_STAFF"
  description String?

  // Global roles have tenantId = null. Custom restaurant roles have a tenantId.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  permissions Permission[]
  userRoles   UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(uuid())
  action      String // e.g., "order.read", "menu.create"
  description String?

  roles Role[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Context: What restaurant does this role apply to? 
  // e.g., User A is "MANAGER" at Tenant X.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // A user can only hold a specific role once per tenant
  @@unique([userId, roleId, tenantId])
}

// -----------------------------------------------------------------------------
// STUBS (To satisfy relations for now, fully fleshed out in later sprints)
// -----------------------------------------------------------------------------
model Customer {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Rider {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  
  isOnline   Boolean  @default(false)
  currentLat Float?
  currentLng Float?

  orders     Order[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Branch {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String
}

// -----------------------------------------------------------------------------
// MENU & CATALOG
// -----------------------------------------------------------------------------
model MenuCategory {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  menuItems   MenuItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenuItem {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuCategoryId String
  category       MenuCategory @relation(fields: [menuCategoryId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  price          Float
  image          String?      // S3 URL
  isActive       Boolean      @default(true)
  isAvailable    Boolean      @default(true)

  // Stripe Integration
  stripeProductId String?

  modifierGroups    ModifierGroup[]
  orderItems        OrderItem[]
  recipeIngredients RecipeIngredient[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ModifierGroup {
  id          String   @id @default(uuid())
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  
  name        String   // e.g., "Choose your Size"
  isRequired  Boolean  @default(false)
  minSelection Int     @default(0)
  maxSelection Int?    // null = unlimited

  options     ModifierOption[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ModifierOption {
  id              String        @id @default(uuid())
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  name            String        
  price           Float         @default(0) 
  isAvailable     Boolean       @default(true)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// -----------------------------------------------------------------------------
// ORDERS & CHECKOUT
// -----------------------------------------------------------------------------
model Order {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  
  // Guest customer info (since auth is pending)
  customerName    String
  customerPhone   String
  deliveryAddress String
  city            String?
  notes           String?

  status          String   @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, RESTAURANT_ACCEPTED, PREPARING, READY, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  
  riderId         String?
  rider           Rider?   @relation(fields: [riderId], references: [id])

  subtotal        Float
  deliveryFee     Float
  serviceFee      Float
  taxAmount       Float
  discountAmount  Float    @default(0.0)
  totalAmount     Float

  items           OrderItem[]

  // Commission Tracking
  platformCommission Float @default(0.0)
  tenantEarnings     Float @default(0.0)

  // Payment Tracking
  stripeSessionId String?  @unique
  statusHistory   OrderStatusHistory[]
  review          Review?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  
  name       String
  quantity   Int
  price      Float
  modifiers  Json     // Storing chosen modifiers as JSON for history snapshot

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  status    String
  notes     String?

  createdAt DateTime @default(now())
}

model Coupon {
  id             String   @id @default(uuid())
  code           String   @unique
  discountType   String   // PERCENTAGE, FIXED
  discountValue  Float
  minOrderValue  Float    @default(0.0)
  isActive       Boolean  @default(true)
  
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Review {
  id             String   @id @default(uuid())
  rating         Int
  comment        String?
  customerName   String

  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id])
  
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  createdAt      DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entity      String
  entityId    String?
  userId      String?
  ipAddress   String?
  details     Json?
  
  createdAt   DateTime @default(now())
}

// -----------------------------------------------------------------------------
// INVENTORY MANAGEMENT
// -----------------------------------------------------------------------------
model Ingredient {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  name              String
  unit              String   // e.g., 'pieces', 'kg', 'liters'
  currentStock      Float    @default(0)
  lowStockThreshold Float    @default(10)

  recipeIngredients RecipeIngredient[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RecipeIngredient {
  id               String     @id @default(uuid())
  menuItemId       String
  menuItem         MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId     String
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  
  quantityRequired Float      // How much of the ingredient is needed for 1 unit of the MenuItem

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

